{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coolify Applications Teams API",
    "version": "0.1"
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.coolify.io/api/v1/teams",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all teams."
        },
        {
          "info": {
            "name": "Get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.coolify.io/api/v1/teams/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Team ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get team by TeamId."
        },
        {
          "info": {
            "name": "Members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.coolify.io/api/v1/teams/:id/members",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Team ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get members by TeamId."
        },
        {
          "info": {
            "name": "Authenticated Team",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.coolify.io/api/v1/teams/current",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get currently authenticated team."
        },
        {
          "info": {
            "name": "Authenticated Team Members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.coolify.io/api/v1/teams/current/members",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get currently authenticated team members."
        }
      ]
    }
  ],
  "bundled": true
}